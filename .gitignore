# ─── Next.js build outputs ────────────────────────────────────────────────────
.next/
out/
dist/

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Test coverage ────────────────────────────────────────────────────────────
coverage/

# ─── Environment files — never commit secrets ─────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# ─── TypeScript build cache ───────────────────────────────────────────────────
*.tsbuildinfo

# ─── OS metadata ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ─── Debug logs ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── CSV exports ─────────────────────────────────────────────────────────────
# Client-side exports must never be committed — they may contain sensitive URLs.
*.csv

# ─── Temporary directories ────────────────────────────────────────────────────
tmp/
temp/

# ─── PM2 runtime files ────────────────────────────────────────────────────────
# PM2 process dumps and logs belong to the server, not the repository.
.pm2/
ecosystem.config.js.bak

# ─── Vercel / deployment cache ────────────────────────────────────────────────
.vercel
